diff --color -ruN a/libvips/iofuncs/thread.c b/libvips/iofuncs/thread.c
--- a/libvips/iofuncs/thread.c	2026-09-26 16:59:16
+++ b/libvips/iofuncs/thread.c	2026-11-27 21:52:13
@@ -52,6 +52,10 @@
 #include <vips/internal.h>
 #include <vips/debug.h>
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten/threading.h>
+#endif
+
 #ifdef G_OS_WIN32
 #include <windows.h>
 #endif /*G_OS_WIN32*/
@@ -83,6 +87,13 @@
 gboolean
 vips_thread_isvips(void)
 {
+#ifdef __EMSCRIPTEN__
+	/* No threads: the calling thread runs every worker.
+	 */
+	if (!emscripten_has_threading_support())
+		return TRUE;
+#endif
+
 	return g_private_get(&is_vips_thread_key) != NULL;
 }
 
