diff --git a/test/e2e/specs/editor/various/client-side-media-nothreads-extra.spec.js b/test/e2e/specs/editor/various/client-side-media-nothreads-extra.spec.js
new file mode 100644
index 00000000..c1c70ee3
--- /dev/null
+++ b/test/e2e/specs/editor/various/client-side-media-nothreads-extra.spec.js
@@ -0,0 +1,206 @@
+const path = require( 'path' );
+const fs = require( 'fs/promises' );
+const os = require( 'os' );
+const { randomUUID } = require( 'crypto' );
+const { createRequire } = require( 'node:module' );
+const { pathToFileURL } = require( 'node:url' );
+const { test, expect } = require( '@wordpress/e2e-test-utils-playwright' );
+const {
+	skipIfClientSideMediaInactive,
+} = require( './client-side-media-utils' );
+
+const wasmVipsEntry = pathToFileURL(
+	createRequire( require.resolve( '@wordpress/vips/package.json' ) ).resolve(
+		'wasm-vips'
+	)
+).href;
+
+const ASSETS_DIR = path.join( __dirname, '..', '..', '..', 'assets' );
+
+async function upload( input, fileName ) {
+	const dir = await fs.mkdtemp( path.join( os.tmpdir(), 'gutenberg-test-media-' ) );
+	const file = path.join( dir, randomUUID() + path.extname( fileName ) );
+	await fs.copyFile( path.join( ASSETS_DIR, fileName ), file );
+	await input.setInputFiles( file );
+}
+
+async function waitForUploadQueueEmpty( page, timeout = 120_000 ) {
+	await page.waitForFunction(
+		() => window.wp.data.select( 'core/upload-media' ).getItems().length === 0,
+		undefined,
+		{ timeout }
+	);
+}
+
+async function probe( url ) {
+	const { default: Vips } = await import( wasmVipsEntry );
+	const vips = await Vips( {} );
+	const response = await fetch( url );
+	const image = vips.Image.newFromBuffer(
+		new Uint8Array( await response.arrayBuffer() )
+	);
+	return {
+		width: image.width,
+		height: image.height,
+		format: image.format,
+		bits: image.getTypeof( 'bits-per-sample' ) ? image.getInt( 'bits-per-sample' ) : null,
+	};
+}
+
+test.describe( 'Client-side media processing, extra cases', () => {
+	test.beforeAll( async ( { requestUtils } ) => {
+		await requestUtils.deleteAllMedia();
+	} );
+
+	test.beforeEach( async ( { admin, page } ) => {
+		await admin.createNewPost();
+		await skipIfClientSideMediaInactive( page, test );
+	} );
+
+	test.afterEach( async ( { requestUtils } ) => {
+		await requestUtils.deleteAllMedia();
+	} );
+
+	for ( const bits of [ 10, 12 ] ) {
+		test( `decodes a ${ bits }-bit AVIF and generates its sub-sizes`, async ( {
+			page,
+			editor,
+			requestUtils,
+		} ) => {
+			await editor.insertBlock( { name: 'core/image' } );
+			const imageBlock = editor.canvas.locator(
+				'role=document[name="Block: Image"i]'
+			);
+			await upload(
+				imageBlock.locator( 'data-testid=form-file-upload-input' ),
+				`1024x683_e2e_test_image_${ bits }bit.avif`
+			);
+			await expect(
+				imageBlock.getByRole( 'img', {
+					name: 'This image has an empty alt attribute',
+				} )
+			).toHaveAttribute( 'src', /^https?:\/\//, { timeout: 60_000 } );
+			await waitForUploadQueueEmpty( page );
+
+			const id = await page.evaluate(
+				() =>
+					window.wp.data.select( 'core/block-editor' ).getSelectedBlock()
+						?.attributes?.id
+			);
+			const media = await requestUtils.rest( {
+				path: `/wp/v2/media/${ id }`,
+			} );
+
+			expect( media.mime_type ).toBe( 'image/avif' );
+			expect( media.media_details.width ).toBe( 1024 );
+			expect( media.media_details.height ).toBe( 683 );
+			for ( const sizeName of [ 'thumbnail', 'medium', 'medium_large' ] ) {
+				const size = media.media_details.sizes[ sizeName ];
+				expect( size, sizeName ).toBeDefined();
+				const probed = await probe( size.source_url );
+				expect( probed.width ).toBe( size.width );
+				expect( probed.height ).toBe( size.height );
+				test.info().annotations.push( {
+					type: 'sub-size',
+					description: `${ sizeName } ${ probed.width }x${ probed.height } ${ probed.format } bits=${ probed.bits }`,
+				} );
+			}
+		} );
+	}
+
+	test( 'cancels an upload while vips is processing it', async ( {
+		page,
+		editor,
+		requestUtils,
+	} ) => {
+		await page.evaluate( () => {
+			window.__capturedBlobWorkers = [];
+			const OriginalWorker = window.Worker;
+			window.Worker = class extends OriginalWorker {
+				constructor( scriptURL, options ) {
+					super( scriptURL, options );
+					if ( String( scriptURL ).startsWith( 'blob:' ) ) {
+						window.__capturedBlobWorkers.push( this );
+					}
+				}
+			};
+		} );
+
+		await editor.insertBlock( { name: 'core/image' } );
+		const imageBlock = editor.canvas.locator(
+			'role=document[name="Block: Image"i]'
+		);
+		await upload(
+			imageBlock.locator( 'data-testid=form-file-upload-input' ),
+			'5000x4000_e2e_test_image_oversized.jpeg'
+		);
+
+		await page.waitForFunction(
+			() => window.__capturedBlobWorkers.length > 0,
+			undefined,
+			{ timeout: 30_000 }
+		);
+		// Let vips start on the image before cancelling.
+		await page.waitForTimeout( 300 );
+
+		const cancelMs = await page.evaluate( async () => {
+			const { select, dispatch } = window.wp.data;
+			const start = performance.now();
+			for ( const item of select( 'core/upload-media' ).getItems() ) {
+				if ( ! item.parentId ) {
+					await dispatch( 'core/upload-media' ).cancelItem(
+						item.id,
+						new Error( 'Cancelled' ),
+						true
+					);
+				}
+			}
+			await new Promise( ( resolve ) => {
+				const check = () =>
+					select( 'core/upload-media' ).getItems().length === 0
+						? resolve()
+						: setTimeout( check, 10 );
+				check();
+			} );
+			return Math.round( performance.now() - start );
+		} );
+		test.info().annotations.push( {
+			type: 'cancel',
+			description: `queue empty ${ cancelMs } ms after cancel`,
+		} );
+		expect( cancelMs ).toBeLessThan( 30_000 );
+
+		await expect
+			.poll( () =>
+				page.evaluate( () =>
+					window.wp.data.select( 'core/editor' ).isPostSavingLocked()
+				)
+			)
+			.toBe( false );
+
+		// The next upload still completes in the same editor session.
+		await editor.setContent( '' );
+		await editor.insertBlock( { name: 'core/image' } );
+		const nextBlock = editor.canvas.locator(
+			'role=document[name="Block: Image"i]'
+		);
+		await upload(
+			nextBlock.locator( 'data-testid=form-file-upload-input' ),
+			'1024x768_e2e_test_image_size.jpeg'
+		);
+		await expect(
+			nextBlock.getByRole( 'img', {
+				name: 'This image has an empty alt attribute',
+			} )
+		).toHaveAttribute( 'src', /^https?:\/\//, { timeout: 60_000 } );
+		await waitForUploadQueueEmpty( page );
+
+		const id = await page.evaluate(
+			() =>
+				window.wp.data.select( 'core/block-editor' ).getSelectedBlock()
+					?.attributes?.id
+		);
+		const media = await requestUtils.rest( { path: `/wp/v2/media/${ id }` } );
+		expect( media.media_details.sizes.medium ).toBeDefined();
+	} );
+} );
