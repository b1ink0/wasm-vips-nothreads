+++ b/libvips/iofuncs/threadpool.c	2026-11-27 17:16:37
@@ -113,7 +113,13 @@
 {
 	/* 3 is the useful minimum, and huge values can crash the machine.
 	 */
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+	/* No threads to start on startup.
+	 */
+	const char *max_threads_env = NULL;
+#else
 	const char *max_threads_env = g_getenv("VIPS_MAX_THREADS");
+#endif
