<?xml version="1.0"?>
<ruleset name="wasm-vips-nothreads-demo">
	<description>WordPress Coding Standards for the plugin.</description>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="7.2"/>
	<config name="text_domain" value="wasm-vips-nothreads-demo"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wasm_vips_nothreads_demo"/>
			</property>
		</properties>
	</rule>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<file>plugins</file>
	<exclude-pattern>plugins/*/build/*</exclude-pattern>
</ruleset>
